<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0C0F0A"
    android:clickable="true"
    android:fillViewport="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="48dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_overlay_logo"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.28"
            android:text="@string/overlay_brand"
            android:textColor="#C8F56A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:includeFontPadding="false"
            android:text="@string/overlay_title"
            android:textColor="#E6E9DE"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:breakStrategy="balanced"
            android:gravity="center"
            android:hyphenationFrequency="none"
            android:lineSpacingExtra="6dp"
            android:text="@string/overlay_body"
            android:textColor="#E6E9DE"
            android:textSize="21sp"
            android:textStyle="italic" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:gravity="center"
            android:text="@string/overlay_countdown_label"
            android:textColor="#8C9482"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/overlay_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:text="5"
            android:textColor="#C8F56A"
            android:textSize="72sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_leave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_overlay_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/overlay_leave"
            android:textColor="#172000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_stay"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_overlay_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/overlay_stay"
            android:textColor="#C3C8B8"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
